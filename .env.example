# Copy this file to .env and fill in real values. Never commit the real .env file.

# ---- PostgreSQL ----
DB_NAME=enactus_ensi
DB_USERNAME=enactus
DB_PASSWORD=change-me-strong-password
DB_PORT=5432

# ---- Backend (Spring Boot) ----
BACKEND_PORT=8080
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-base64-secret
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=http://localhost:3000
MAX_UPLOAD_SIZE=5MB
MAX_UPLOAD_SIZE_BYTES=5242880
SEED_ENABLED=true

# Initial admin account, created on first startup only (idempotent).
ADMIN_EMAIL=admin@enactus-ensi.org
ADMIN_PASSWORD=change-me-strong-password

# ---- Frontend (Next.js) ----
FRONTEND_PORT=3000
# Publicly reachable URL of the backend API (used by the browser).
NEXT_PUBLIC_API_URL=http://localhost:8080
